# Set to "true" once Meta or Twilio keys are added in Vercel to send WhatsApp
# notifications automatically in the background without opening wa.me.
VITE_USE_WHATSAPP_API=false

# Your clinic WhatsApp number with country code (no '+' or spaces)
CLINIC_WHATSAPP_NUMBER=919368869685

# Provider: "meta" or "twilio"
WHATSAPP_PROVIDER=meta

# --- Meta WhatsApp Cloud API ---
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Twilio WhatsApp API ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
